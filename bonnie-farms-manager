        }
      `}</style>

      <div className="bf-shell" style={{ display: "flex", minHeight: "100vh" }}>
        <div className="bf-sidebar" style={{
          width: 226,
          flexShrink: 0,
          background: COLORS.ink,
          color: "#EFE9D8",
          padding: "26px 18px",
          display: "flex",
          flexDirection: "column",
          gap: 4,
        }}>
          <div className="bf-sidebar-title" style={{ marginBottom: 22, paddingLeft: 4 }}>
            <div style={{ fontFamily: "'Fraunces', serif", fontSize: 19, fontWeight: 600, lineHeight: 1.25, color: "#F6F1E4" }}>
              Bonnie Farms
            </div>
            <div style={{ fontSize: 11.5, letterSpacing: 0.3, color: "#B9AE8C", marginTop: 2 }}>
              SMC LTD · Farm register
            </div>
          </div>
          {NAV.map((n) => (
            <button
              key={n.id}
              className="bf-nav-item"
              onClick={() => goTo(n.id)}
              style={{
                display: "flex",
                alignItems: "center",
                gap: 10,
                background: active === n.id ? "rgba(246,241,228,0.12)" : "transparent",
                border: "none",
                borderLeft: active === n.id ? `3px solid ${COLORS.amber}` : "3px solid transparent",
                color: active === n.id ? "#F6F1E4" : "#C9BFA1",
                padding: "10px 10px",
                borderRadius: 3,
                fontSize: 13.5,
                fontFamily: "'IBM Plex Sans', sans-serif",
                cursor: "pointer",
                textAlign: "left",
              }}
            >
              <Icon name={n.icon} size={17} />
              {n.label}
            </button>
          ))}
        </div>

        <div style={{ flex: 1, padding: "32px 40px", maxWidth: 980 }}>
