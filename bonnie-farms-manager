  health: "M12 21s-7-4.5-9.5-9C.5 8 2 4 6 4c2 0 4 1.5 6 4 2-2.5 4-4 6-4 4 0 5.5 4 3.5 8-2.5 4.5-9.5 9-9.5 9z",
  cash: "M3 7h18v10H3zM12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM6 9v5M18 9v5",
};

function Icon({ name, size = 18 }) {
  const d = ICONS[name];
  if (!d) return null;
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round">
      <path d={d} />
    </svg>
  );
}

function Field({ f, value, onChange, options }) {
  const commonStyle = {
    width: "100%",
    padding: "9px 10px",
    borderRadius: 4,
    border: `1px solid ${COLORS.line}`,
    background: COLORS.surface,
    fontFamily: "'IBM Plex Sans', sans-serif",
    fontSize: 14,
    color: COLORS.ink,
    boxSizing: "border-box",
  };
  if (f.type === "select") {
    const opts = f.dynamicOptions ? options : f.options;
    return (
      <select style={commonStyle} value={value ?? ""} onChange={(e) => onChange(e.target.value)}>
        <option value="">{f.placeholder || "Select…"}</option>
        {(opts || []).map((o) => (
          <option key={o} value={o}>{o}</option>
        ))}
      </select>
    );
  }
  if (f.type === "textarea") {
    return (
      <textarea
        style={{ ...commonStyle, minHeight: 60, resize: "vertical" }}
        value={value ?? ""}
        onChange={(e) => onChange(e.target.value)}
        placeholder={f.placeholder || ""}
      />
    );
  }
  return (
    <input
      style={commonStyle}
      type={f.type}
      value={value ?? ""}
      onChange={(e) => onChange(e.target.value)}
      placeholder={f.placeholder || ""}
      min={f.type === "number" ? 0 : undefined}
    />
  );
}

function RecordManager({ storageKey, fields, columns, batchOptions, title, emptyHint, extraSummary }) {
  const [records, setRecords] = useState(null);
  const [form, setForm] = useState({});
  const [editingId, setEditingId] = useState(null);
  const [error, setError] = useState("");
  const [saving, setSaving] = useState(false);

  useEffect(() => {
    let alive = true;
    loadKey(storageKey, []).then((data) => {
      if (alive) setRecords(data);
    });
    return () => { alive = false; };
  }, [storageKey]);

  const resetForm = () => {
    setForm({});
    setEditingId(null);
    setError("");
  };

  const startEdit = (rec) => {
    setForm(rec);
    setEditingId(rec.id);
    setError("");
  };

  const persist = async (next) => {
    setRecords(next);
    setSaving(true);
    await saveKey(storageKey, next);
    setSaving(false);
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    for (const f of fields) {
      if (f.required && !String(form[f.key] ?? "").trim()) {
        setError(`${f.label} is required.`);
        return;
      }
    }
    if (editingId) {
      const next = records.map((r) => (r.id === editingId ? { ...form, id: editingId } : r));
      await persist(next);
    } else {
      const next = [{ ...form, id: uid() }, ...records];
      await persist(next);
    }
    resetForm();
  };

  const handleDelete = async (id) => {
    const next = records.filter((r) => r.id !== id);
    await persist(next);
    if (editingId === id) resetForm();
  };

  if (records === null) {
    return <div style={{ padding: "2rem 0", color: COLORS.muted, fontSize: 14 }}>Loading records…</div>;
  }

  const sorted = [...records].sort((a, b) => (b.date || "").localeCompare(a.date || "") || 0);

  return (
    <div>
      {extraSummary ? extraSummary(records) : null}

      <form onSubmit={handleSubmit} style={{
        background: COLORS.surface,
        border: `1px solid ${COLORS.line}`,
        borderRadius: 6,
        padding: "18px 20px",
        marginBottom: 24,
      }}>
        <div style={{ fontFamily: "'Fraunces', serif", fontSize: 16, fontWeight: 600, marginBottom: 14, color: COLORS.ink }}>
          {editingId ? "Update entry" : `Add new ${title.toLowerCase()} entry`}
        </div>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(180px, 1fr))", gap: "12px 16px" }}>
          {fields.map((f) => (
            <div key={f.key}>
              <label style={{ display: "block", fontSize: 12.5, color: COLORS.muted, marginBottom: 5, fontWeight: 500 }}>
                {f.label}{f.required ? " *" : ""}
              </label>
              <Field
                f={f}
                value={form[f.key]}
                onChange={(v) => setForm((s) => ({ ...s, [f.key]: v }))}
                options={f.dynamicOptions === "batches" ? batchOptions : f.options}
              />
            </div>
          ))}
        </div>
        {error ? <div style={{ color: COLORS.rust, fontSize: 13, marginTop: 10 }}>{error}</div> : null}
        <div style={{ marginTop: 16, display: "flex", gap: 10 }}>
          <button type="submit" style={{
            background: COLORS.green,
            color: "#fff",
            border: "none",
            borderRadius: 4,
            padding: "9px 18px",
            fontSize: 13.5,
            fontWeight: 500,
            fontFamily: "'IBM Plex Sans', sans-serif",
            cursor: "pointer",
          }}>
            {editingId ? "Save changes" : "Add entry"}
          </button>
          {editingId ? (
            <button type="button" onClick={resetForm} style={{
              background: "transparent",
              color: COLORS.ink,
              border: `1px solid ${COLORS.line}`,
              borderRadius: 4,
              padding: "9px 18px",
              fontSize: 13.5,
              fontFamily: "'IBM Plex Sans', sans-serif",
              cursor: "pointer",
            }}>
              Cancel
            </button>
          ) : null}
          {saving ? <span style={{ alignSelf: "center", fontSize: 12, color: COLORS.muted }}>Saving…</span> : null}
        </div>
      </form>

      {sorted.length === 0 ? (
        <div style={{ padding: "24px 0", color: COLORS.muted, fontSize: 14, borderTop: `1px solid ${COLORS.line}` }}>
          {emptyHint || "No entries yet. Add your first one above."}
        </div>
      ) : (
        <div style={{ overflowX: "auto" }}>
          <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 13.5 }}>
            <thead>
              <tr style={{ borderBottom: `2px solid ${COLORS.ink}` }}>
                {columns.map((c) => (
                  <th key={c.key} style={{ textAlign: c.align || "left", padding: "8px 10px", fontWeight: 600, color: COLORS.ink, fontFamily: "'IBM Plex Sans', sans-serif" }}>
                    {c.label}
                  </th>
                ))}
                <th style={{ padding: "8px 10px" }}></th>
              </tr>
            </thead>
            <tbody>
              {sorted.map((r) => (
                <tr key={r.id} style={{ borderBottom: `1px solid ${COLORS.line}` }}>
                  {columns.map((c) => (
                    <td key={c.key} style={{ textAlign: c.align || "left", padding: "8px 10px", color: COLORS.ink }}>
                      {c.render ? c.render(r) : (r[c.key] ?? "—")}
                    </td>
                  ))}
                  <td style={{ padding: "8px 10px", textAlign: "right", whiteSpace: "nowrap" }}>
                    <button onClick={() => startEdit(r)} style={{ background: "none", border: "none", cursor: "pointer", color: COLORS.green, fontSize: 12.5, marginRight: 12, fontFamily: "'IBM Plex Sans', sans-serif" }}>
                      Edit
                    </button>
                    <button onClick={() => handleDelete(r.id)} style={{ background: "none", border: "none", cursor: "pointer", color: COLORS.rust, fontSize: 12.5, fontFamily: "'IBM Plex Sans', sans-serif" }}>
                      Delete
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  );
}

function StatCard({ label, value, tone }) {
  const bg = tone === "amber" ? COLORS.amberLight : tone === "rust" ? COLORS.rustLight : COLORS.greenLight;
  const fg = tone === "amber" ? COLORS.amber : tone === "rust" ? COLORS.rust : COLORS.green;
  return (
    <div style={{ background: bg, borderRadius: 6, padding: "16px 18px", minWidth: 150 }}>
      <div style={{ fontSize: 12.5, color: COLORS.muted, marginBottom: 6, fontWeight: 500 }}>{label}</div>
      <div style={{ fontFamily: "'Fraunces', serif", fontSize: 26, fontWeight: 600, color: fg }}>{value}</div>
    </div>
  );
}

function Dashboard({ data }) {
  const { batches, production, feed, health, finance } = data;

  const activeBatches = batches.filter((b) => b.status === "Active");
  const totalBirds = activeBatches.reduce((s, b) => s + (Number(b.currentCount) || 0), 0);

  const today = todayISO();
  const eggsToday = production
    .filter((p) => p.date === today)
    .reduce((s, p) => s + (Number(p.traysCollected) || 0) * 30 + (Number(p.looseEggs) || 0) - (Number(p.broken) || 0), 0);

  const feedThisWeek = feed
    .filter((f) => daysAgo(f.date) <= 6 && daysAgo(f.date) >= 0)
    .reduce((s, f) => s + (Number(f.quantityKg) || 0), 0);

  const nowMonth = today.slice(0, 7);
  const mortalityThisMonth = health
    .filter((h) => h.recordType === "Mortality" && (h.date || "").startsWith(nowMonth))
    .reduce((s, h) => s + (Number(h.count) || 0), 0);

  const incomeThisMonth = finance
    .filter((f) => f.type === "Income" && (f.date || "").startsWith(nowMonth))
    .reduce((s, f) => s + (Number(f.amount) || 0), 0);
  const expenseThisMonth = finance
    .filter((f) => f.type === "Expense" && (f.date || "").startsWith(nowMonth))
    .reduce((s, f) => s + (Number(f.amount) || 0), 0);
  const netThisMonth = incomeThisMonth - expenseThisMonth;

  const recentMortality = health.filter((h) => h.recordType === "Mortality").sort((a, b) => (b.date || "").localeCompare(a.date || "")).slice(0, 5);
  const recentFinance = [...finance].sort((a, b) => (b.date || "").localeCompare(a.date || "")).slice(0, 6);

  return (
    <div>
      <div style={{ fontFamily: "'Fraunces', serif", fontSize: 28, fontWeight: 600, color: COLORS.ink, marginBottom: 4 }}>
        Farm overview
      </div>
      <div style={{ fontSize: 14, color: COLORS.muted, marginBottom: 24 }}>
        {fmtDate(today)} · {activeBatches.length} active batch{activeBatches.length === 1 ? "" : "es"}
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))", gap: 14, marginBottom: 32 }}>
        <StatCard label="Total birds on farm" value={totalBirds.toLocaleString()} />
        <StatCard label="Eggs collected today" value={eggsToday.toLocaleString()} tone="amber" />
        <StatCard label="Feed used (7 days)" value={`${feedThisWeek.toLocaleString()} kg`} />
        <StatCard label="Mortality this month" value={mortalityThisMonth.toLocaleString()} tone="rust" />
        <StatCard label="Net this month" value={fmtUGX(netThisMonth)} tone={netThisMonth >= 0 ? "green" : "rust"} />
      </div>

      <div style={{ display: "grid", gridTemplateColumns: "1.1fr 1fr", gap: 28 }}>
        <div>
          <div style={{ fontFamily: "'Fraunces', serif", fontSize: 17, fontWeight: 600, marginBottom: 10, color: COLORS.ink }}>
            Recent finance entries
          </div>
          {recentFinance.length === 0 ? (
            <div style={{ fontSize: 13.5, color: COLORS.muted }}>No finance entries logged yet.</div>
          ) : (
            <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 13.5 }}>
              <tbody>
                {recentFinance.map((f) => (
                  <tr key={f.id} style={{ borderBottom: `1px solid ${COLORS.line}` }}>
                    <td style={{ padding: "7px 4px", color: COLORS.muted, width: 90 }}>{fmtDate(f.date)}</td>
                    <td style={{ padding: "7px 4px" }}>{f.category || "—"}</td>
                    <td style={{ padding: "7px 4px", textAlign: "right", fontWeight: 500, color: f.type === "Income" ? COLORS.green : COLORS.rust }}>
                      {f.type === "Income" ? "+" : "−"}{fmtUGX(f.amount)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
        <div>
          <div style={{ fontFamily: "'Fraunces', serif", fontSize: 17, fontWeight: 600, marginBottom: 10, color: COLORS.ink }}>
            Recent mortality
          </div>
          {recentMortality.length === 0 ? (
            <div style={{ fontSize: 13.5, color: COLORS.muted }}>No mortality logged — keep it that way.</div>
          ) : (
            <table style={{ width: "100%", borderCollapse: "collapse", fontSize: 13.5 }}>
              <tbody>
                {recentMortality.map((h) => (
                  <tr key={h.id} style={{ borderBottom: `1px solid ${COLORS.line}` }}>
                    <td style={{ padding: "7px 4px", color: COLORS.muted, width: 90 }}>{fmtDate(h.date)}</td>
                    <td style={{ padding: "7px 4px" }}>{h.batchName || "—"}</td>
                    <td style={{ padding: "7px 4px", textAlign: "right", fontWeight: 500, color: COLORS.rust }}>{h.count || 0} birds</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </div>
    </div>
  );
}

const BIRD_TYPES = ["Layers", "Broilers", "Kienyeji / Local", "Breeders"];
const BATCH_STATUS = ["Active", "Sold", "Closed"];
const FEED_TYPES = ["Chick Mash", "Growers Mash", "Layers Mash", "Broiler Starter", "Broiler Finisher", "Other"];
const HEALTH_TYPES = ["Vaccination", "Treatment", "Health check", "Mortality"];
const FINANCE_TYPES = ["Income", "Expense"];
const INCOME_CATEGORIES = ["Egg sales", "Bird sales", "Manure sales", "Other income"];
const EXPENSE_CATEGORIES = ["Feed purchase", "Chicks / birds", "Medication & vaccines", "Labor", "Utilities", "Transport", "Equipment", "Other expense"];

export default function App() {
  const [active, setActive] = useState("dashboard");
  const [dash, setDash] = useState({ batches: [], production: [], feed: [], health: [], finance: [] });
  const [dashLoading, setDashLoading] = useState(true);
  const [refreshTick, setRefreshTick] = useState(0);

  useEffect(() => {
    let alive = true;
    Promise.all([
      loadKey("batches", []),
      loadKey("production", []),
      loadKey("feed", []),
      loadKey("health", []),
      loadKey("finance", []),
    ]).then(([batches, production, feed, health, finance]) => {
      if (alive) {
        setDash({ batches, production, feed, health, finance });
        setDashLoading(false);
      }
    });
    return () => { alive = false; };
  }, [active, refreshTick]);

  const batchNames = useMemo(
    () => dash.batches.filter((b) => b.status === "Active").map((b) => b.batchName).filter(Boolean),
    [dash.batches]
  );

  const goTo = (id) => {
    setActive(id);
    setRefreshTick((t) => t + 1);
  };

  return (
    <div style={{ background: COLORS.cream, minHeight: "100vh", fontFamily: "'IBM Plex Sans', sans-serif", color: COLORS.ink }}>
      <style>{`
        @import url('${FONT_LINK}');
        * { box-sizing: border-box; }
