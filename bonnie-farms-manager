          )}

          {active === "feed" && (
            <div>
              <SectionHeader title="Feed & stock" subtitle="Track feed given out per batch, and its cost." />
              <RecordManager
                storageKey="feed"
                title="feed"
                emptyHint="No feed entries yet. Log a feeding above."
                batchOptions={batchNames}
                fields={[
                  { key: "date", label: "Date", type: "date", required: true },
                  { key: "batchName", label: "Batch", type: "select", dynamicOptions: "batches" },
                  { key: "feedType", label: "Feed type", type: "select", options: FEED_TYPES },
                  { key: "quantityKg", label: "Quantity (kg)", type: "number" },
                  { key: "costUGX", label: "Cost (UGX)", type: "number" },
                  { key: "notes", label: "Notes", type: "textarea" },
                ]}
                columns={[
                  { key: "date", label: "Date", render: (r) => fmtDate(r.date) },
                  { key: "batchName", label: "Batch" },
                  { key: "feedType", label: "Feed type" },
                  { key: "quantityKg", label: "Kg", align: "right" },
                  { key: "costUGX", label: "Cost", align: "right", render: (r) => fmtUGX(r.costUGX) },
                ]}
              />
            </div>
          )}

          {active === "health" && (
            <div>
              <SectionHeader title="Health & mortality" subtitle="Vaccinations, treatments, health checks and mortality in one log." />
              <RecordManager
                storageKey="health"
                title="health"
                emptyHint="No health records yet. Log a vaccination, treatment or mortality above."
                batchOptions={batchNames}
                fields={[
                  { key: "date", label: "Date", type: "date", required: true },
                  { key: "batchName", label: "Batch", type: "select", dynamicOptions: "batches" },
                  { key: "recordType", label: "Record type", type: "select", options: HEALTH_TYPES, required: true },
                  { key: "description", label: "Description", type: "text", placeholder: "e.g. Newcastle disease vaccine" },
                  { key: "count", label: "Birds affected / count", type: "number" },
                  { key: "costUGX", label: "Cost (UGX)", type: "number" },
                  { key: "notes", label: "Notes", type: "textarea" },
                ]}
                columns={[
                  { key: "date", label: "Date", render: (r) => fmtDate(r.date) },
                  { key: "batchName", label: "Batch" },
                  {
                    key: "recordType", label: "Type",
                    render: (r) => (
                      <span style={{
                        fontSize: 12,
                        padding: "2px 8px",
                        borderRadius: 3,
                        background: r.recordType === "Mortality" ? COLORS.rustLight : COLORS.greenLight,
                        color: r.recordType === "Mortality" ? COLORS.rust : COLORS.green,
                      }}>{r.recordType}</span>
                    ),
                  },
                  { key: "description", label: "Description" },
                  { key: "count", label: "Count", align: "right" },
                  { key: "costUGX", label: "Cost", align: "right", render: (r) => fmtUGX(r.costUGX) },
                ]}
              />
            </div>
          )}

          {active === "finance" && (
            <div>
              <SectionHeader title="Finance" subtitle="Every shilling in and out — egg sales, bird sales, feed, labor and more." />
              <RecordManager
                storageKey="finance"
                title="finance"
                emptyHint="No finance entries yet. Log income or an expense above."
                extraSummary={(records) => {
                  const income = records.filter((r) => r.type === "Income").reduce((s, r) => s + (Number(r.amount) || 0), 0);
                  const expense = records.filter((r) => r.type === "Expense").reduce((s, r) => s + (Number(r.amount) || 0), 0);
                  return (
                    <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(150px, 1fr))", gap: 14, marginBottom: 24 }}>
                      <StatCard label="Total income" value={fmtUGX(income)} tone="green" />
                      <StatCard label="Total expense" value={fmtUGX(expense)} tone="rust" />
                      <StatCard label="Net balance" value={fmtUGX(income - expense)} tone={income - expense >= 0 ? "green" : "rust"} />
                    </div>
                  );
                }}
                fields={[
                  { key: "date", label: "Date", type: "date", required: true },
                  { key: "type", label: "Type", type: "select", options: FINANCE_TYPES, required: true },
                  {
                    key: "category", label: "Category", type: "select",
                    options: [...INCOME_CATEGORIES, ...EXPENSE_CATEGORIES],
                  },
                  { key: "amount", label: "Amount (UGX)", type: "number", required: true },
                  { key: "description", label: "Description", type: "text" },
                ]}
                columns={[
                  { key: "date", label: "Date", render: (r) => fmtDate(r.date) },
                  {
                    key: "type", label: "Type",
                    render: (r) => (
                      <span style={{ color: r.type === "Income" ? COLORS.green : COLORS.rust, fontWeight: 500 }}>{r.type}</span>
                    ),
                  },
                  { key: "category", label: "Category" },
                  { key: "description", label: "Description" },
                  {
                    key: "amount", label: "Amount", align: "right",
                    render: (r) => (
                      <span style={{ color: r.type === "Income" ? COLORS.green : COLORS.rust, fontWeight: 500 }}>
                        {r.type === "Income" ? "+" : "−"}{fmtUGX(r.amount)}
                      </span>
                    ),
                  },
                ]}
              />
            </div>
          )}
        </div>
      </div>
    </div>
  );
}

function SectionHeader({ title, subtitle }) {
  return (
    <div style={{ marginBottom: 22, paddingBottom: 16, borderBottom: `1px solid ${COLORS.line}` }}>
      <div style={{ fontFamily: "'Fraunces', serif", fontSize: 26, fontWeight: 600, color: COLORS.ink }}>{title}</div>
      <div style={{ fontSize: 14, color: COLORS.muted, marginTop: 4 }}>{subtitle}</div>
    </div>
  );
}
