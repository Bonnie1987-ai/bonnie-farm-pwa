import { useState, useEffect, useCallback, useMemo } from "react";

const FONT_LINK = "https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap";

const COLORS = {
  cream: "#F6F1E4",
  ink: "#2A2318",
  green: "#3F5B37",
  greenLight: "#E7EEE3",
  amber: "#B9740F",
  amberLight: "#F7EAD3",
  rust: "#9A3B2C",
  rustLight: "#F3E1DC",
  surface: "#FFFDF6",
  line: "#DCD3BC",
  muted: "#7A7053",
};

function uid() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}

function todayISO() {
  return new Date().toISOString().slice(0, 10);
}

function fmtUGX(n) {
  const v = Number(n) || 0;
  return "UGX " + Math.round(v).toLocaleString("en-UG");
}

function fmtDate(d) {
  if (!d) return "—";
  const dt = new Date(d + "T00:00:00");
  if (isNaN(dt.getTime())) return d;
  return dt.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
}

function daysAgo(dateStr) {
  const dt = new Date(dateStr + "T00:00:00");
  const now = new Date();
  now.setHours(0, 0, 0, 0);
  return Math.round((now - dt) / 86400000);
}

async function loadKey(key, fallback) {
  try {
    const res = await window.storage.get(key, false);
    if (res && res.value) return JSON.parse(res.value);
    return fallback;
  } catch (e) {
    return fallback;
  }
}

async function saveKey(key, value) {
  try {
    await window.storage.set(key, JSON.stringify(value), false);
    return true;
  } catch (e) {
    return false;
  }
}

const NAV = [
  { id: "dashboard", label: "Dashboard", icon: "grid" },
  { id: "batches", label: "Flock batches", icon: "birds" },
  { id: "production", label: "Egg production", icon: "egg" },
  { id: "feed", label: "Feed & stock", icon: "feed" },
  { id: "health", label: "Health & mortality", icon: "health" },
  { id: "finance", label: "Finance", icon: "cash" },
];

const ICONS = {
  grid: "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z",
  birds: "M4 15c1-4 4-7 8-7s7 3 8 7M8 8V4l3 2M6 15l-2 5M18 15l2 5",
  egg: "M12 3c4 3 7 9 7 13a7 7 0 0 1-14 0c0-4 3-10 7-13z",
